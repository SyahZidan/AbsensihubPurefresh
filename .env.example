# =============================================================================
# SATU file .env untuk localhost DAN InfinityFree
# =============================================================================
# - Buka di localhost (XAMPP) → otomatis pakai MySQL lokal (127.0.0.1 / absensi_umkm)
# - Buka di InfinityFree → otomatis pakai DB_HOST / DB_PASS di bawah
#
# Opsional override lokal (jika DB XAMPP beda):
# DB_HOST_LOCAL=127.0.0.1
# DB_NAME_LOCAL=absensi_umkm
# DB_USER_LOCAL=root
# DB_PASS_LOCAL=

# --- Production (InfinityFree) — wajib di hosting ---
DB_HOST=sql303.infinityfree.com
DB_PORT=3306
